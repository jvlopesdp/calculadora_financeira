# =============================================================================
# .env.example — calculadorafinanceira.app
# -----------------------------------------------------------------------------
# Copie para .env.local (dev) e preencha os valores. NÃO commitar .env.local.
# Em produção, os segredos vão para Cloudflare Workers via:
#   wrangler secret put <NOME>
# As variáveis prefixadas com VITE_ são expostas ao bundle do frontend.
# As demais são lidas apenas pelo Worker (server-side).
# =============================================================================


# ---------------------------------------------------------------------------
# App / URLs
# ---------------------------------------------------------------------------
# URL pública da aplicação. Em dev geralmente http://localhost:5173
VITE_APP_URL=http://localhost:5173

# URL base usada pelo Better Auth (deve bater com APP_URL na maioria dos casos)
BETTER_AUTH_URL=http://localhost:5173

# URL pública de produção (referência — não consumida em runtime, só docs):
#   https://calculadorafinanceira.app


# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# Segredo usado para assinar tokens/cookies. Gere com:
#   openssl rand -base64 32
# Em produção, defina via: wrangler secret put BETTER_AUTH_SECRET
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32


# ---------------------------------------------------------------------------
# Cloudflare Turnstile (anti-bot — cadastro/login)
# ---------------------------------------------------------------------------
# Obtenha em: https://dash.cloudflare.com/?to=/:account/turnstile
# Site key é pública (vai no bundle do frontend).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key fica apenas no Worker.
# Em produção: wrangler secret put TURNSTILE_SECRET_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA


# ---------------------------------------------------------------------------
# Resend (e-mails transacionais)
# ---------------------------------------------------------------------------
# Crie a key em: https://resend.com/api-keys
# Em produção: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente verificado no Resend (DKIM/SPF configurado em DNS).
# Sugestão para produção: no-reply@calculadorafinanceira.app
EMAIL_FROM=no-reply@calculadorafinanceira.app


# ---------------------------------------------------------------------------
# Cloudflare — deploy (CI apenas; NÃO definir localmente)
# ---------------------------------------------------------------------------
# Token com escopo: Workers Scripts:Edit, D1:Edit, Account Settings:Read.
# Defina como GitHub Actions secret, não no .env.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=


# ---------------------------------------------------------------------------
# D1 (referência — binding real é configurado em wrangler.jsonc)
# ---------------------------------------------------------------------------
# Nome do banco no Cloudflare:
#   calculadora-financeira-db
# Database ID (gerado por `wrangler d1 create calculadora-financeira-db`)
# deve ser preenchido em wrangler.jsonc, não aqui.
